#!/bin/sh
set -e

# Verify the index without stashing, staging, or modifying working-tree changes.
node --permission --allow-child-process scripts/run.ts \
  --permission \
  --allow-fs-read=./package.json \
  --allow-fs-read=./node_modules \
  --allow-fs-read=./.window-merger-index-* \
  --allow-fs-write=./.window-merger-index-* \
  --allow-child-process \
  -- scripts/pre-commit.ts
