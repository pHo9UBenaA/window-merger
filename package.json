{
	"name": "window-merger",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.21.0 <25"
	},
	"author": "Komiya",
	"contributors": [
		"pHo9UBenaA <pho9ubenaa@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/pHo9UBenaA/window-merger.git"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@playwright/test": "catalog:",
		"@secretlint/secretlint-rule-preset-recommend": "catalog:",
		"@types/chrome": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"esbuild": "catalog:",
		"secretlint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"build": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-fs-read=./src --allow-child-process ./scripts/build/main.ts",
		"check": "biome check --write .",
		"ci": "biome ci . --error-on-warnings",
		"format": "biome format --write .",
		"lint": "biome lint --write . --error-on-warnings",
		"test": "vitest run",
		"test:browser": "pnpm zip && playwright test --project=chromium",
		"test:browser:compat": "pnpm zip && playwright test --project=compat",
		"test:coverage": "vitest run --coverage",
		"test:stress": "pnpm zip && playwright test --project=stress",
		"typecheck": "tsc --noEmit",
		"check:dependencies": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-child-process ./scripts/check-dependencies/collect.ts | node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts ./scripts/check-dependencies/check.ts",
		"check:secrets": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-child-process ./scripts/check-secrets/main.ts",
		"chrome:install": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-child-process ./scripts/chrome-install/main.ts",
		"chrome:update-lock": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-child-process ./scripts/chrome-update/main.ts",
		"chrome:matrix": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-fs-read=./src/assets/manifest.json --allow-fs-read=./test/browser/chrome-versions.json ./scripts/chrome-matrix/main.ts",
		"hook:pre-commit": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-child-process ./scripts/pre-commit/main.ts",
		"hook:pre-push": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-child-process ./scripts/pre-push/main.ts",
		"release:check": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-child-process ./scripts/release/check.ts",
		"release:publish": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-child-process ./scripts/release/main.ts",
		"version": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts ./scripts/sync-version/read.ts | node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-fs-read=./src/assets/manifest.json --allow-fs-write=./src/assets/manifest.json ./scripts/sync-version/write.ts && git add -- src/assets/manifest.json",
		"zip": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-child-process ./scripts/package/main.ts",
		"scripts:generate": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts --allow-fs-write=./package.json --allow-fs-write=./scripts/build/commands.generated.ts --allow-fs-write=./scripts/package/commands.generated.ts --allow-fs-write=./scripts/check-dependencies/commands.generated.ts --allow-fs-write=./scripts/check-secrets/commands.generated.ts --allow-fs-write=./scripts/chrome-install/commands.generated.ts --allow-fs-write=./scripts/chrome-update/commands.generated.ts --allow-fs-write=./scripts/chrome-matrix/commands.generated.ts --allow-fs-write=./scripts/pre-commit/commands.generated.ts --allow-fs-write=./scripts/pre-push/commands.generated.ts --allow-fs-write=./scripts/release/commands.generated.ts --allow-fs-write=./scripts/sync-version/commands.generated.ts --allow-fs-write=./scripts/lib/commands.generated.ts ./scripts/generate-commands.ts",
		"scripts:check": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts ./scripts/generate-commands.ts --check"
	},
	"license": "MIT",
	"packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
