{
	"name": "window-merger",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.21.0 <25"
	},
	"author": "Komiya",
	"contributors": [
		"pHo9UBenaA <pho9ubenaa@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/pHo9UBenaA/window-merger.git"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@playwright/test": "catalog:",
		"@secretlint/secretlint-rule-preset-recommend": "catalog:",
		"@types/chrome": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"esbuild": "catalog:",
		"secretlint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"build": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/lib/project-root.ts --allow-fs-read=./node_modules --allow-fs-read=./src/assets --allow-fs-read=./LICENSE --allow-fs-read=./dist --allow-fs-write=./dist --allow-child-process ./scripts/build.ts",
		"check": "biome check --write .",
		"check:dependencies": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/lib/pnpm-command.ts --allow-child-process ./scripts/check-dependencies.ts",
		"check:secrets": "node --permission --allow-fs-read=. --allow-child-process ./scripts/check-secrets.ts",
		"chrome:install": "node --permission --allow-child-process ./scripts/run.ts --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/lib/project-root.ts --allow-fs-read=./src/assets/manifest.json --allow-fs-read=./test/browser/chrome-versions.json --allow-fs-read=./test/browser/chrome-checksums.json --allow-fs-read=@runner-temp/window-merger-chrome-install-* --allow-fs-write=@runner-temp/window-merger-chrome-install-* --allow-fs-write=@github-env --allow-child-process -- ./scripts/chrome-compat.ts --install",
		"chrome:update-lock": "node --permission --allow-child-process ./scripts/run.ts --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/lib/project-root.ts --allow-fs-read=./src/assets/manifest.json --allow-fs-read=./test/browser/chrome-checksums.json --allow-fs-read=@tmpdir/window-merger-chrome-hash-* --allow-fs-write=./test/browser/chrome-checksums.json --allow-fs-write=./test/browser/chrome-versions.json --allow-fs-write=@tmpdir/window-merger-chrome-hash-* --allow-child-process -- ./scripts/chrome-compat.ts --update-lock",
		"ci": "biome ci . --error-on-warnings",
		"format": "biome format --write .",
		"lint": "biome lint --write . --error-on-warnings",
		"test": "vitest run",
		"test:browser": "pnpm zip && playwright test --project=chromium",
		"test:browser:compat": "pnpm zip && playwright test --project=compat",
		"test:coverage": "vitest run --coverage",
		"test:stress": "pnpm zip && playwright test --project=stress",
		"typecheck": "tsc --noEmit",
		"version": "node --permission --allow-child-process ./scripts/run.ts --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/lib/release-version.ts --allow-fs-read=./scripts/lib/validate-extension.ts --allow-fs-read=./src/assets/manifest.json --allow-fs-write=./src/assets/manifest.json --allow-child-process -- ./scripts/sync-version.ts",
		"zip": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/lib/project-root.ts --allow-fs-read=./scripts/build.ts --allow-fs-read=./scripts/lib/validate-extension.ts --allow-fs-read=./node_modules --allow-fs-read=./src/assets --allow-fs-read=./LICENSE --allow-fs-read=./dist* --allow-fs-write=./dist* --allow-child-process ./scripts/package.ts"
	},
	"license": "MIT",
	"packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
