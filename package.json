{
	"name": "window-merger",
	"type": "module",
	"author": "Komiya",
	"contributors": [
		"pHo9UBenaA <pho9ubenaa@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "http://github.com/npm/npm.git"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@playwright/test": "catalog:",
		"@secretlint/secretlint-rule-preset-recommend": "catalog:",
		"@types/chrome": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"esbuild": "catalog:",
		"fflate": "catalog:",
		"secretlint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"build": "node --experimental-strip-types ./build.ts",
		"zip": "node --experimental-strip-types ./scripts/package.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:browser": "pnpm build && playwright test --project=chromium",
		"test:stress": "pnpm build && playwright test --project=stress",
		"ci": "biome ci . --error-on-warnings",
		"format": "biome format --write .",
		"lint": "biome lint --write . --error-on-warnings",
		"check": "biome check --write .",
		"typecheck": "tsgo",
		"typecheck:tsc": "tsc --noEmit"
	},
	"license": "MIT",
	"packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
