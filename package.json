{
	"name": "window-merger",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.21.0 <25"
	},
	"author": "Komiya",
	"contributors": [
		"pHo9UBenaA <pho9ubenaa@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/pHo9UBenaA/window-merger.git"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@playwright/test": "catalog:",
		"@secretlint/secretlint-rule-preset-recommend": "catalog:",
		"@types/chrome": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"esbuild": "catalog:",
		"secretlint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"build": "node --experimental-strip-types ./scripts/build.ts",
		"zip": "node --experimental-strip-types ./scripts/package.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:browser": "pnpm zip && playwright test --project=chromium",
		"test:browser:compat": "pnpm zip && playwright test --project=compat",
		"chrome:update-lock": "node --experimental-strip-types scripts/chrome-compat.ts --update-lock",
		"chrome:install": "node --experimental-strip-types scripts/chrome-compat.ts --install",
		"test:stress": "pnpm zip && playwright test --project=stress",
		"ci": "biome ci . --error-on-warnings",
		"check:secrets": "node --experimental-strip-types scripts/check-secrets.ts",
		"check:dependencies": "node --experimental-strip-types scripts/check-dependencies.ts",
		"format": "biome format --write .",
		"lint": "biome lint --write . --error-on-warnings",
		"check": "biome check --write .",
		"typecheck": "tsgo",
		"typecheck:tsc": "tsc --noEmit"
	},
	"license": "MIT",
	"packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27"
}
