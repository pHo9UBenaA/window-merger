{
	"name": "window-merger",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.21.0 <25"
	},
	"author": "Komiya",
	"contributors": [
		"pHo9UBenaA <pho9ubenaa@gmail.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/pHo9UBenaA/window-merger.git"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@playwright/test": "catalog:",
		"@secretlint/secretlint-rule-preset-recommend": "catalog:",
		"@types/chrome": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"esbuild": "catalog:",
		"secretlint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"scripts": {
		"build": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/runtime --allow-child-process ./scripts/run.ts build",
		"check": "biome check --write .",
		"check:dependencies": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/runtime --allow-child-process ./scripts/run.ts check-dependencies",
		"check:secrets": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/runtime --allow-child-process ./scripts/run.ts check-secrets",
		"chrome:install": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/runtime --allow-child-process ./scripts/run.ts chrome-install",
		"chrome:update-lock": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/runtime --allow-child-process ./scripts/run.ts chrome-update",
		"ci": "biome ci . --error-on-warnings",
		"format": "biome format --write .",
		"lint": "biome lint --write . --error-on-warnings",
		"test": "vitest run",
		"test:browser": "pnpm zip && playwright test --project=chromium",
		"test:browser:compat": "pnpm zip && playwright test --project=compat",
		"test:coverage": "vitest run --coverage",
		"test:stress": "pnpm zip && playwright test --project=stress",
		"typecheck": "tsc --noEmit",
		"version": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/runtime --allow-child-process ./scripts/run.ts sync-version && git add -- src/assets/manifest.json",
		"zip": "node --permission --allow-fs-read=./package.json --allow-fs-read=./scripts/runtime --allow-child-process ./scripts/run.ts package"
	},
	"license": "MIT",
	"packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
